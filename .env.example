# Contact form delivery (optional).
# When set, enquiries are POSTed as JSON to this URL (e.g. your own API, a form
# service such as Formspree, or an automation webhook). When unset, the form
# validates input but does NOT send anything and says so on screen.
# Set this BEFORE `npm run build` — the contact page reads it at build time.
CONTACT_FORM_ENDPOINT=

# Optional bearer token sent as `Authorization: Bearer <token>` to the endpoint.
CONTACT_FORM_TOKEN=

# Optional public site URL (e.g. https://www.example.ie) used as metadataBase
# for canonical/OpenGraph URLs. Leave blank until the domain is confirmed.
NEXT_PUBLIC_SITE_URL=
